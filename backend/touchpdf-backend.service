[Unit]
Description=TouchPDF backend (LibreOffice/Ghostscript conversions)
After=network.target

[Service]
User=touchpdf
Group=touchpdf
Environment=HOME=/opt/touchpdf
Environment=PORT=4100
Environment=ALLOWED_ORIGINS=https://www.touchpdf.space,https://touchpdf.space,http://localhost:3000
WorkingDirectory=/opt/touchpdf/backend
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
# Sandbox — this service parses untrusted files, so it gets the tightest box:
# own user, private /tmp (jobs run there), read-only OS, no privilege escalation.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/touchpdf
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
